// Flattened man.rs2's @man_drop_table label, shared by all 5 of its
// [ai_queue3,...] trigger keys (see triggers.dropdata). ~trail_easycluedrop
// / ~trail_checkmediumdrop tertiary clue rolls excluded (separate
// NPC-agnostic system). map_members is always true, so the bolt drop is
// included unconditionally; its quantity is ~random_range(2,12) in the
// source - transcribed here as 7, the range's midpoint, for display only
// (does not affect drop rate). Slots 120-127 (8/128) match no branch: no
// additional drop.
[man_drop_table]
table=drop_table
data=total,128
data=drop,iron_dagger,1,1
data=drop,bronze_med_helm,1,2
data=drop,bolt,7,22
data=drop,bronze_arrow,7,3
data=drop,earthrune,4,2
data=drop,firerune,6,2
data=drop,mindrune,9,2
data=drop,chaosrune,2,1
data=subtable,randomherb,23
data=drop,coins,3,38
data=drop,coins,5,9
data=drop,coins,15,4
data=drop,coins,25,1
data=drop,fishing_bait,1,5
data=drop,copper_ore,1,2
data=drop,earth_talisman,1,2
data=drop,cabbage,1,1
