// Flattened ice_giant.rs2's [ai_queue3,icegiant] table.
// npc_param(death_drop) resolves to big_bones, a real guaranteed drop.
// map_members is always true, so the bloodrune branch is used (not the
// f2p black_kiteshield fallback). Slots 114-127 (14/128) match no branch:
// no additional drop.
[icegiant]
