// Flattened skeleton.rs2's @skeleton_armed label, shared by both
// [ai_queue3,skeleton_armed] and [ai_queue3,giantskeleton] (see
// triggers.dropdata). npc_param(death_drop) is unset (null) on both
// debugnames, so no guaranteed drop. Slots 120-127 (8/128) match no
// branch: no additional drop.
[skeleton_armed]
table=drop_table
data=total,128
data=drop,iron_med_helm,1,6
data=drop,iron_sword,1,4
data=drop,iron_axe,1,2
data=drop,iron_scimitar,1,1
data=drop,airrune,15,3
data=drop,waterrune,9,3
data=drop,chaosrune,5,3
data=drop,iron_arrow,12,2
data=drop,lawrune,2,2
data=drop,cosmicrune,2,1
data=subtable,randomherb,20
data=drop,coins,10,24
data=drop,coins,5,25
data=drop,coins,25,8
data=drop,coins,45,4
data=drop,coins,65,3
data=drop,coins,1,2
data=drop,bronze_bar,1,5
data=subtable,randomjewel,2
