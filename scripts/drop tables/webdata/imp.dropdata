// Flattened imp.rs2's [ai_queue3,imp] table. npc_param(death_drop)
// resolves to ashes, a real guaranteed drop; the table also has its own
// separate ashes branch (slots 106-111), a real second chance at an extra
// ashes drop distinct from the guaranteed one - both are transcribed.
// Full coverage: the final acne_potion branch has no explicit upper
// bound in the source ("else"), reaching exactly total=128.
[imp]
table=drop_table
data=total,128
data=guaranteed,ashes,1
data=drop,black_bead,1,5
data=drop,red_bead,1,5
data=drop,white_bead,1,5
data=drop,yellow_bead,1,5
data=drop,bolt,1,8
data=drop,bluewizhat,1,8
data=drop,egg,1,5
data=drop,raw_chicken,1,5
data=drop,burnt_bread,1,4
data=drop,burnt_meat,1,4
data=drop,cabbage,1,2
data=drop,bread_dough,1,2
data=drop,bread,1,1
data=drop,cooked_meat,1,1
data=drop,hammer,1,8
data=drop,tinderbox,1,5
data=drop,shears,1,4
data=drop,bucket_empty,1,4
data=drop,bucket_water,1,2
data=drop,jug_empty,1,2
data=drop,jug_water,1,2
data=drop,pot_empty,1,2
data=drop,pot_flour,1,2
data=drop,ball_of_wool,1,8
data=drop,mind_talisman,1,7
data=drop,ashes,1,6
data=drop,clay,1,4
data=drop,cadavaberries,1,4
data=drop,grain,1,3
data=drop,chefs_hat,1,2
data=drop,flier,1,2
data=drop,acne_potion,1,1
