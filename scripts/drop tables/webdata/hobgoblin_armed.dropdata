// Flattened hobgoblin.rs2's [ai_queue3,hobgoblin_armed] table (level 42
// hobgoblins). npc_param(death_drop) is unset (null) on this NPC's
// config, so no guaranteed drop. map_members is always true, so the
// iron_javelin branch is included unconditionally. Two consecutive
// branches both drop coins,1 (one map_members-gated, one unconditional) -
// combined here into one row at their summed weight (3+1=4). Slots
// 115-127 (13/128) match no branch: no additional drop.
[hobgoblin_armed]
table=drop_table
data=total,128
data=drop,iron_sword,1,3
data=drop,steel_dagger,1,3
data=drop,steel_longsword,1,1
data=drop,lawrune,2,3
data=drop,waterrune,2,2
data=drop,firerune,7,2
data=drop,bodyrune,6,2
data=drop,chaosrune,3,2
data=drop,naturerune,4,2
data=drop,cosmicrune,2,1
data=drop,iron_javelin,5,1
data=subtable,randomherb,7
data=drop,coins,15,34
data=drop,coins,5,12
data=drop,coins,28,4
data=drop,coins,62,4
data=drop,coins,42,3
data=drop,coins,1,4
data=drop,limpwurt_root,1,21
data=drop,goblin_armour,1,2
data=subtable,randomjewel,2
