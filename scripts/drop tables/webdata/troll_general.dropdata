// Flattened troll_commander.rs2's [ai_queue3,_troll_general] table.
// npc_param(death_drop) resolves to big_bones on every category member
// (troll_general/2/3, death_troll_commander/leuitanant/guard1/guard2), so
// it's a real guaranteed drop. The troll_key_prison drop (gated on
// npc_type, %troll_quest progress, and an existing-key check) is
// per-player quest state, out of scope per the "no quest-state" resolved
// decision - condition treated as false, branch excluded. The final
// randomjewel branch has no explicit upper bound in the source ("else"),
// so its weight is the remainder up to total (128-123=5).
[troll_general]
table=drop_table
data=total,128
data=guaranteed,big_bones,1
data=drop,steel_platebody,1,4
data=drop,black_warhammer,1,3
data=drop,steel_warhammer,1,3
data=drop,adamant_axe,1,2
data=drop,adamant_sq_shield,1,1
data=drop,granite_shield,1,1
data=drop,mithril_platebody,1,1
data=drop,rune_warhammer,1,1
data=drop,earthrune,80,8
data=drop,naturerune,16,5
data=drop,lawrune,4,3
data=drop,earthrune,65,1
data=drop,earthrune,25,1
data=subtable,randomherb,15
data=drop,coins,40,29
data=drop,coins,135,25
data=drop,coins,190,10
data=drop,coins,20,4
data=drop,coins,420,1
data=drop,cert_coal,6,3
data=drop,cert_raw_tuna,4,2
data=subtable,randomjewel,5
