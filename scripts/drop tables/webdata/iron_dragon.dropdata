// Flattened iron_dragon.rs2's [ai_queue3,iron_dragon] table. Same
// independent-roll structure as bronze_dragon (flagged on #57): a
// random(512)=0 check for dragon_platelegs, mutually exclusive with and
// checked before the normal $dropint table. Modeled the same way - this
// wrapper table's total is 512, dragon_platelegs gets weight 1, and the
// remaining 511/512 is a subtable reference to iron_dragon_normal.
// npc_param(death_drop) resolves to dragon_bones; iron_bar,5 is a
// separate unconditional obj_add - both guaranteed.
[iron_dragon]
table=drop_table
data=total,512
data=guaranteed,dragon_bones,1
data=guaranteed,iron_bar,5
data=drop,dragon_platelegs,1,1
data=subtable,iron_dragon_normal,511

// iron_dragon's $dropint table (only reached on the 511/512 branch
// above). ~trail_hardcluedrop is a tertiary clue-scroll roll, excluded
// (separate NPC-agnostic system). The bolts quantity is
// calc(random(11) + 2) in the source (uniform 2-12) - transcribed as 6
// (the range's floor-midpoint) for display only (does not affect drop
// rate). Slots 123-127 (5/128) match no branch: no additional drop.
[iron_dragon_normal]
table=drop_table
data=total,128
data=drop,rune_dart_p,9,7
data=drop,adamant_2h_sword,1,4
data=drop,adamant_axe,1,3
data=drop,adamant_battleaxe,1,3
data=drop,rune_knife,5,3
data=drop,adamant_sq_shield,1,1
data=drop,rune_med_helm,1,1
data=drop,rune_battleaxe,1,1
data=drop,rune_javelin,4,20
data=drop,bloodrune,15,19
data=drop,bolts,6,6
data=drop,soulrune,3,5
data=drop,coins,270,20
data=drop,coins,550,10
data=drop,coins,990,1
data=drop,1dose2strength,1,8
data=drop,adamantite_bar,2,3
data=drop,curry,1,3
data=subtable,ultrarare_getitem,2
data=subtable,randomjewel,3
