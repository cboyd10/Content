// Flattened white_knight.rs2's [ai_queue3,white_knight] table.
// npc_param(death_drop) is unset (null) on this NPC's config, so no
// guaranteed drop. map_members is always true, so the bloodrune branch is
// included unconditionally. bodyrune/waterrune/coins quantities are
// ~random_range(...) in the source - transcribed as their floor-midpoint
// for display only (does not affect drop rate): bodyrune
// random_range(9,13)->11, waterrune random_range(25,30)->27, coins
// random_range(45,53)->49. Slots 126-127 (2/128) match no branch: no
// additional drop (the source's own comment confirms "2 for nothing").
[white_knight]
table=drop_table
data=total,128
data=drop,iron_longsword,1,2
data=drop,steel_sword,1,1
data=drop,steel_med_helm,1,1
data=drop,mindrune,5,11
data=drop,naturerune,4,4
data=drop,bodyrune,11,3
data=drop,chaosrune,2,3
data=drop,waterrune,27,3
data=drop,mithril_arrow,5,2
data=drop,adamant_arrow,2,1
data=drop,bloodrune,2,1
data=drop,lawrune,2,1
data=subtable,randomherb,5
data=drop,coins,5,15
data=drop,coins,48,15
data=drop,coins,15,15
data=drop,coins,49,10
data=drop,coins,1,5
data=drop,coins,2,5
data=drop,coins,120,1
data=drop,coins,8,10
data=drop,iron_bar,2,6
data=drop,iron_bar,1,2
data=drop,half_an_apple_pie,1,1
data=drop,iron_ore,1,1
