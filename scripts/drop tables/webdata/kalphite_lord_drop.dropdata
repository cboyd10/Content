// Flattened kalphite_guardian.rs2's @kalphite_lord_drop label, shared by
// both [ai_queue3,kalphite_lord] and [ai_queue3,kalphite_lord_chamber]
// (see triggers.dropdata). npc_param(death_drop) is unset (null) on both
// debugnames, so no guaranteed drop. The final ultrarare_getitem branch
// has no explicit upper bound in the source ("else"), so its weight is
// the remainder up to total (128-127=1).
[kalphite_lord_drop]
table=drop_table
data=total,128
data=drop,mithril_sword,1,4
data=drop,steel_battleaxe,1,3
data=drop,mithril_axe,1,2
data=drop,adamant_dagger,1,2
data=drop,mithril_kiteshield,1,1
data=drop,rune_med_helm,1,1
data=drop,rune_chainbody,1,1
data=drop,airrune,50,8
data=drop,chaosrune,10,7
data=drop,bloodrune,7,4
data=drop,firerune,37,1
data=drop,lawrune,3,1
data=subtable,randomherb,23
data=drop,coins,132,40
data=drop,coins,30,7
data=drop,coins,44,6
data=drop,coins,220,6
data=drop,coins,460,1
data=drop,lobster,1,3
data=drop,3dose1defense,1,1
data=subtable,randomjewel,5
data=subtable,ultrarare_getitem,1
