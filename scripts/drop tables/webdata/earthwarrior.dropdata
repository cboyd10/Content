// Flattened earth_warrior.rs2's [ai_queue3,earthwarrior] table. This
// script never calls npc_param(death_drop) at all, so there is no
// guaranteed drop regardless of the .npc config's own death_drop param.
// Slots 82-127 (46/128) match no branch: no additional drop.
[earthwarrior]
table=drop_table
data=total,128
data=drop,steel_spear,1,3
data=drop,staff_of_earth,1,2
data=drop,earthrune,12,13
data=drop,naturerune,3,9
data=drop,chaosrune,3,7
data=drop,lawrune,2,6
data=drop,deathrune,2,4
data=drop,earthrune,60,3
data=drop,bloodrune,2,1
data=subtable,randomherb,14
data=drop,coins,12,18
data=subtable,randomjewel,2
