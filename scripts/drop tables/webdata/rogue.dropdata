// Flattened rogue.rs2's [ai_queue3,rogue] table. npc_param(death_drop) is
// unset (null) on this NPC's config, so no guaranteed drop.
// ~trail_easycluedrop is a tertiary clue-scroll roll, excluded (separate
// NPC-agnostic system). bolt's quantity is ~random_range(2,12) in the
// source - transcribed as 7 (the range's midpoint), matching
// man_drop_table's identical roll from #57. Slots 120-127 (8/128) match
// no branch: no additional drop (the source's own comment confirms
// "8/128 nothing").
[rogue]
table=drop_table
data=total,128
data=drop,bronze_med_helm,1,2
data=drop,iron_dagger,1,1
data=drop,bolt,7,22
data=drop,bronze_arrow,7,3
data=drop,earthrune,4,2
data=drop,firerune,6,2
data=drop,mindrune,9,2
data=drop,chaosrune,2,1
data=subtable,randomherb,23
data=drop,coins,3,38
data=drop,coins,5,9
data=drop,coins,15,4
data=drop,coins,25,1
data=drop,fishing_bait,1,5
data=drop,copper_ore,1,2
data=drop,earth_talisman,1,2
data=drop,cabbage,1,1
