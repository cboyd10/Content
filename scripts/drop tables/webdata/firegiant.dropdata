// Flattened fire_giant.rs2's [ai_queue3,firegiant] table. Composes
// randomherb/randomjewel/ultrarare_getitem by weight rather than
// re-deriving them here. `guaranteed,big_bones,1` is npc_param(death_drop)
// on the firegiant .npc config (scripts/_unpack/225/all.npc), not a random
// roll - always drops alongside whichever random-table item lands.
[firegiant]
table=drop_table
data=total,128
data=guaranteed,big_bones,1
data=drop,steel_axe,1,3
data=drop,mithril_sq_shield,1,2
data=drop,fire_battlestaff,1,1
data=drop,rune_scimitar,1,1
data=drop,firerune,150,10
data=drop,chaosrune,5,7
data=drop,rune_arrow,12,5
data=drop,bloodrune,5,4
data=drop,firerune,37,1
data=drop,lawrune,2,1
data=subtable,randomherb,19
data=drop,coins,60,40
data=drop,coins,15,7
data=drop,coins,25,6
data=drop,coins,300,2
data=drop,coins,50,1
data=drop,lobster,1,3
data=drop,steel_bar,1,2
data=drop,2dose1strength,1,1
data=subtable,randomjewel,11
data=subtable,ultrarare_getitem,1
