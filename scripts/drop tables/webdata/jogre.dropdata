// Flattened jogre.rs2's [ai_queue3,jogre] table. This NPC rolls
// randominc(128), not random(128) - an inclusive 0..128 range, i.e. 129
// possible outcomes, so total=129 here (matching the source's own
// ~trail_mediumcluedrop(129, npc_coord) tertiary call, excluded as a
// clue-scroll roll). npc_param(death_drop) resolves to tbwt_jogre_bones,
// a real guaranteed drop. Slots 90-128 (39/129) match no branch: no
// additional drop.
[jogre]
table=drop_table
data=total,129
data=guaranteed,tbwt_jogre_bones,1
data=drop,bronze_spear,1,30
data=drop,iron_spear,1,4
data=drop,naturerune,2,10
data=drop,naturerune,10,2
data=drop,naturerune,5,2
data=drop,steel_javelin,5,2
data=subtable,randomherb,6
data=drop,pineapple,2,8
data=drop,knife,1,5
data=drop,bones,1,3
data=drop,big_bones,1,3
data=drop,big_bones,3,2
data=drop,bones,1,2
data=subtable,randomjewel,1
data=drop,unidentified_snake_weed,1,5
data=drop,unidentified_rogues_purse,1,5
