// Flattened paladin.rs2's [ai_queue3,paladin] table (the ~paladin_drops
// proc it calls is local to this file, not a cross-file shared
// subroutine, so it's flattened directly here). npc_param(death_drop) is
// unset (null) on this NPC's config, so no guaranteed drop.
// ~trail_mediumcluedrop is a tertiary clue-scroll roll, excluded (separate
// NPC-agnostic system). Slots 126-127 (2/128) match no branch: no
// additional drop.
[paladin]
table=drop_table
data=total,128
data=drop,steel_sword,1,2
data=drop,steel_longsword,1,1
data=drop,steel_full_helm,1,1
data=drop,waterrune,30,13
data=drop,bloodrune,1,1
data=drop,iron_bar,1,9
data=drop,mithril_bar,1,1
data=drop,steel_bar,1,1
data=subtable,randomherb,8
data=drop,coins,48,40
data=drop,coins,15,19
data=drop,coins,2,16
data=drop,coins,8,10
data=drop,coins,120,2
data=subtable,randomjewel,2
