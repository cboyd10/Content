// Flattened kalphite_worker.rs2's @kalphite_worker_drop label, shared by
// both [ai_queue3,kalphite_worker] and [ai_queue3,kalphite_worker_chamber]
// (see triggers.dropdata). npc_param(death_drop) is unset (null) on both
// debugnames, so no guaranteed drop. The final randomjewel branch has no
// explicit upper bound in the source ("else"), so its weight is the
// remainder up to total (128-125=3).
[kalphite_worker_drop]
table=drop_table
data=total,128
data=drop,iron_sword,1,3
data=drop,steel_dagger,1,3
data=drop,hardleather_body,1,2
data=drop,iron_javelin,5,1
data=drop,steel_longsword,1,1
data=drop,lawrune,2,3
data=drop,bodyrune,6,2
data=drop,chaosrune,3,2
data=drop,firerune,7,2
data=drop,waterrune,2,2
data=drop,naturerune,4,2
data=drop,cosmicrune,2,1
data=subtable,randomherb,7
data=drop,coins,15,34
data=drop,coins,5,12
data=drop,coins,28,12
data=drop,coins,1,8
data=drop,coins,62,4
data=drop,coins,42,3
data=drop,water_skin4,1,21
data=subtable,randomjewel,3
